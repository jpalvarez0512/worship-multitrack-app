# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Audio Files pesados (GitHub tiene un límite de 100 MB por archivo)
# Se ignoran archivos de audio grandes en tracks, pero se preservan los JSON y metadatos
tracks/**/*.wav
tracks/**/*.flac
tracks/**/*.aiff
tracks/**/*.mp3
tracks/**/*.ogg
!tracks/**/song.json
!tracks/**/README.md

# Builds y Binarios locales
*.exe
*.apk
*.zip
!deliverables/builds/**/*.gitkeep

# IDEs y Sistema Operativo
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
