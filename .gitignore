# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Audio Files pesados (GitHub tiene un límite de 100 MB por archivo)
# Se ignoran archivos de audio grandes en tracks, pero se preservan los JSON, letras y metadatos
tracks/**/*.wav
tracks/**/*.flac
tracks/**/*.aiff
tracks/**/*.aif
tracks/**/*.mp3
tracks/**/*.ogg
tracks/**/*.m4a
tracks/**/stems/*
!tracks/**/stems/.gitkeep
!tracks/**/chart.pro
!tracks/**/chart.txt
!tracks/**/song.pro
!tracks/**/song.txt
!tracks/**/song.cho
!tracks/**/song.json
!tracks/**/README.md

# Fondos personalizados de proyección (imágenes/videos subidos por el usuario)
config/backgrounds/*
!config/backgrounds/.gitkeep

# Builds y Binarios locales
*.exe
*.apk
*.zip
!deliverables/builds/**/*.gitkeep

# IDEs y Sistema Operativo
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
